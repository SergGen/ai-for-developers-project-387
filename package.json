{
  "name": "ai-for-developers-project-387",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate": "tsp compile api && openapi-ts",
    "dev": "vite",
    "dev:server": "node --watch server/index.ts",
